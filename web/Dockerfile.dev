# The SvelteKit service under `vite dev`, for working on the client.
#
# Unlike web/Dockerfile this image carries no source and no world: app source,
# static addons and the whole mirrored public/ tree are bind-mounted by the
# web-dev service in docker-compose.yml, so an edit on the host reaches the
# browser without an image rebuild. Only node_modules is baked in, because that
# is the part that is slow and does not change.
FROM node:22-alpine

WORKDIR /app

# development, so npm ci keeps devDependencies (vite, SvelteKit) and the
# no-store/dev-client branches in static.js and client-addons.js switch on.
ENV NODE_ENV=development \
    HOST=0.0.0.0 \
    PORT=5173 \
    BASE_PATH=/world \
    PUBLIC_DIR=/app/public

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
